{
  "version": 1,
  "verification": {
    "green": "The shared quality runner, lifecycle hooks, installers and leader completion behavior pass their native regression suites; covered Python sources pass Ruff lint, complexity and formatting checks. Optional native profiles are reported separately when their toolchains are available.",
    "manual": [],
    "review": false
  },
  "roots": [
    "tools/quality",
    "hooks/session/quality_hook.py",
    "hooks/session/quality.py",
    "skills/team-leader/scripts",
    "scripts/test_leader_completion.py",
    "scripts/install.sh",
    "scripts/install_codex.py",
    "scripts/test_install.py",
    "scripts/test_install_packages.py",
    "tools/fanout"
  ],
  "exclude": [
    ".git/*",
    ".quality/*",
    "node_modules/*",
    "*/node_modules/*",
    ".venv/*",
    "target/*",
    "build/*",
    "__pycache__/*",
    "*/__pycache__/*"
  ],
  "tools": {
    "python": {
      "command": [
        "{root}/.quality/ruff/bin/ruff"
      ],
      "version": "0.16.6",
      "install": [
        [
          "uv",
          "venv",
          "{root}/.quality/ruff"
        ],
        [
          "uv",
          "pip",
          "install",
          "--python",
          "{root}/.quality/ruff/bin/python",
          "ruff==0.16.6"
        ]
      ],
      "version_args": [
        "--version"
      ]
    },
    "python-runtime": {
      "command": [
        "python3",
        "-B"
      ],
      "version": "3.13.2",
      "version_args": [
        "--version"
      ],
      "install": []
    }
  },
  "checks": [
    {
      "name": "Ruff lint + C901",
      "tool": "python",
      "args": [
        "check",
        "--no-fix",
        "--extend-select",
        "C901",
        "--config",
        "lint.mccabe.max-complexity=10"
      ],
      "patterns": [
        "tools/quality/*.py",
        "tools/quality/*.pyi",
        "tools/quality/bin/quality",
        "hooks/session/quality*.py",
        "skills/team-leader/scripts/*.py",
        "scripts/test_leader_completion.py",
        "scripts/test_install*.py"
      ],
      "files": true,
      "failure_codes": [
        1
      ],
      "stage": "fast",
      "kind": "lint"
    },
    {
      "name": "Ruff format",
      "tool": "python",
      "args": [
        "format",
        "--check"
      ],
      "patterns": [
        "tools/quality/*.py",
        "tools/quality/*.pyi",
        "tools/quality/bin/quality",
        "hooks/session/quality*.py",
        "skills/team-leader/scripts/*.py",
        "scripts/test_leader_completion.py",
        "scripts/test_install*.py"
      ],
      "files": true,
      "failure_codes": [
        1
      ],
      "stage": "fast",
      "kind": "lint"
    },
    {
      "name": "Installer behavior",
      "kind": "test",
      "tool": "python-runtime",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts",
        "-p",
        "test_install*.py",
        "-v"
      ],
      "patterns": [
        "scripts/install.sh",
        "scripts/install_codex.py",
        "scripts/test_install*.py"
      ],
      "files": false,
      "scope": "project",
      "stage": "fast",
      "failure_codes": [
        1
      ],
      "inputs": [
        "skills/*",
        "configs/codex/*",
        "configs/omp/*"
      ]
    },
    {
      "name": "Quality behavior",
      "kind": "test",
      "tool": "python-runtime",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools/quality/tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "patterns": [
        "tools/quality/*.py",
        "tools/quality/bin/quality",
        "hooks/session/quality*.py"
      ],
      "files": false,
      "scope": "project",
      "stage": "full",
      "failure_codes": [
        1
      ]
    },
    {
      "name": "Leader completion behavior",
      "kind": "test",
      "tool": "python-runtime",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts",
        "-p",
        "test_leader_completion.py",
        "-v"
      ],
      "patterns": [
        "skills/team-leader/scripts/*.py",
        "scripts/test_leader_completion.py"
      ],
      "files": false,
      "scope": "project",
      "stage": "full",
      "failure_codes": [
        1
      ]
    },
    {
      "name": "Fanout behavior",
      "kind": "test",
      "tool": "python-runtime",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools/fanout/tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "patterns": [
        "tools/fanout/*"
      ],
      "files": false,
      "scope": "project",
      "stage": "full",
      "failure_codes": [
        1
      ],
      "inputs": [
        "skills/fanout/*"
      ]
    }
  ],
  "size": {
    "limit": 500,
    "mode": "review"
  }
}
