{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "uncertainties"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "target",
          "trigger",
          "expected",
          "actual",
          "evidence"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "reproduced",
              "hypothesis"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "actual": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 6000
      }
    }
  }
}
