{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changes",
    "checks",
    "blockers"
  ],
  "properties": {
    "changes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 6000
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 6000
      }
    }
  }
}
