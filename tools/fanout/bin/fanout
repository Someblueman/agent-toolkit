#!/usr/bin/env python3
"""Run bounded one-shot harness workers and collect structured results."""

from __future__ import annotations

import argparse
import asyncio
import hashlib
import json
import os
import signal
import sys
import time
from pathlib import Path
from typing import Any

TOOL_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(TOOL_ROOT / "lib"))
from harnesses import (
    dispatch_worker,
    resolve_executable,
    resolve_opencode_sdk,
)
from structured_worker import (
    capture_worker_errors,
    extract_cost,
    extract_tokens,
)
from workflow_engine import run_workflow

SCHEMA_PATH = TOOL_ROOT / "schemas" / "worker-result.schema.json"
OPENCODE_HELPER_PATH = TOOL_ROOT / "lib" / "opencode_worker.mjs"
AGY_RESULT_KEYS = {"worker_id", "summary", "findings", "uncertainties"}
DEFAULT_MODELS = {
    "agy": "gemini-3.7-flash-low",
    "opencode": "opencode-go/deepseek-v4.1-flash",
    "muse": None,
    "pi": "opencode-go/deepseek-v4.1-flash",
    "claude": None,
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Fan out a trusted task prompt to one-shot local workers."
    )
    parser.add_argument("prompt_file", type=Path)
    parser.add_argument("--harness", choices=tuple(DEFAULT_MODELS), default="agy")
    parser.add_argument("--workers", type=int, default=4)
    parser.add_argument("--concurrency", type=int, default=None)
    parser.add_argument("--model")
    parser.add_argument(
        "--agent",
        default="plan",
        help="OpenCode built-in or custom agent (default: plan)",
    )
    parser.add_argument("--output", type=Path)
    parser.add_argument(
        "--workflow", choices=("review-plan", "bug-hunt", "critique", "implement")
    )
    parser.add_argument("--config", type=Path)
    parser.add_argument("--assignments", type=Path)
    parser.add_argument("--input", type=Path, action="append", default=[])
    parser.add_argument("--describe", action="store_true")
    parser.add_argument("--working-directory", type=Path, default=Path.cwd())
    parser.add_argument("--timeout-seconds", type=float, default=300.0)
    parser.add_argument("--agy-retries", type=int, choices=(0, 1))
    parser.add_argument("--max-output-bytes", type=int, default=1_000_000)
    parser.add_argument("--min-results", type=int)
    parser.add_argument("--agy", default="agy", help=argparse.SUPPRESS)
    parser.add_argument("--pi", default="pi", help=argparse.SUPPRESS)
    parser.add_argument("--claude", default="claude", help=argparse.SUPPRESS)
    parser.add_argument("--muse", default="muse", help=argparse.SUPPRESS)
    parser.add_argument("--opencode", default="opencode", help=argparse.SUPPRESS)
    parser.add_argument("--node", default="node", help=argparse.SUPPRESS)
    parser.add_argument("--opencode-sdk", type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    args.provided = {
        arg.split("=", 1)[0] for arg in sys.argv[1:] if arg.startswith("--")
    }
    if not args.workflow and args.provided & {
        "--config",
        "--assignments",
        "--input",
        "--describe",
    }:
        parser.error(
            "--config, --assignments, --input and --describe require --workflow"
        )
    if not args.describe and args.output is None:
        parser.error("--output is required unless --describe is used")
    return args


def validate_args(
    args: argparse.Namespace,
) -> tuple[str, str | None, Path | None, Path, Path, Path]:
    if not 1 <= args.workers <= 50:
        raise ValueError("--workers must be between 1 and 50")
    if args.concurrency is None:
        args.concurrency = min(4, args.workers)
    if not 1 <= args.concurrency <= args.workers:
        raise ValueError("--concurrency must be between 1 and --workers")
    if args.timeout_seconds <= 1:
        raise ValueError("--timeout-seconds must be greater than 1")
    if args.max_output_bytes < 1024:
        raise ValueError("--max-output-bytes must be at least 1024")

    if args.min_results is None:
        args.min_results = args.workers
    if not 1 <= args.min_results <= args.workers:
        raise ValueError("--min-results must be between 1 and --workers")

    if args.model is None:
        args.model = DEFAULT_MODELS[args.harness]
    if not args.agent.strip():
        raise ValueError("--agent must not be empty")
    if args.harness == "agy":
        if args.agy_retries is None:
            args.agy_retries = 1
    elif args.agy_retries is not None:
        raise ValueError("--agy-retries is only valid with --harness agy")

    prompt_path = args.prompt_file.expanduser().resolve()
    working_directory = args.working_directory.expanduser().resolve()
    output = args.output.expanduser().resolve()
    if not prompt_path.is_file():
        raise ValueError(f"prompt file does not exist: {prompt_path}")
    if not working_directory.is_dir():
        raise ValueError(f"working directory does not exist: {working_directory}")
    if args.harness == "agy" and not SCHEMA_PATH.is_file():
        raise ValueError(f"worker result schema does not exist: {SCHEMA_PATH}")
    if args.harness == "opencode" and not OPENCODE_HELPER_PATH.is_file():
        raise ValueError(
            f"OpenCode worker helper does not exist: {OPENCODE_HELPER_PATH}"
        )
    if output.exists() and any(output.iterdir()):
        raise ValueError(f"output directory is not empty: {output}")

    executable_name = getattr(args, args.harness)
    executable_path = resolve_executable(executable_name, args.harness)
    node_path = None
    sdk_path = None
    if args.harness == "opencode":
        node_path = resolve_executable(args.node, "node")
        sdk_path = resolve_opencode_sdk(args.opencode_sdk)

    return (
        executable_path,
        node_path,
        sdk_path,
        prompt_path,
        working_directory,
        output,
    )


async def run(args: argparse.Namespace) -> int:
    if args.workflow:
        return await run_workflow(args)
    (
        executable_path,
        node_path,
        sdk_path,
        prompt_path,
        working_directory,
        output,
    ) = validate_args(args)
    output.mkdir(parents=True, exist_ok=True, mode=0o700)
    output.chmod(0o700)
    prompt_bytes = prompt_path.read_bytes()
    prompt_sha256 = hashlib.sha256(prompt_bytes).hexdigest()
    base_prompt = prompt_bytes.decode("utf-8")
    semaphore = asyncio.Semaphore(args.concurrency)
    started = time.monotonic()

    dependencies = {args.harness: (executable_path, node_path, sdk_path)}
    workers = [
        dispatch_worker(
            {
                "harness": args.harness,
                "model": args.model,
                "settings": {"agent": args.agent} if args.harness == "opencode" else {},
            },
            {
                "index": index,
                "semaphore": semaphore,
                "base_prompt": base_prompt,
                "working_directory": working_directory,
                "output": output,
                "timeout_seconds": args.timeout_seconds,
                "max_output_bytes": args.max_output_bytes,
            },
            dependencies,
            retries=args.agy_retries or 0,
        )
        for index in range(1, args.workers + 1)
    ]

    loop = asyncio.get_running_loop()
    main_task = asyncio.current_task()

    def _handle_sigterm() -> None:
        if main_task and not main_task.done():
            main_task.cancel()

    try:
        loop.add_signal_handler(signal.SIGTERM, _handle_sigterm)
    except (NotImplementedError, RuntimeError):
        pass

    try:
        results = await asyncio.gather(
            *[
                capture_worker_errors(f"worker-{index:04d}", worker)
                for index, worker in enumerate(workers, 1)
            ]
        )
    finally:
        try:
            loop.remove_signal_handler(signal.SIGTERM)
        except (NotImplementedError, RuntimeError):
            pass

    valid_results = sum(result["status"] == "ok" for result in results)

    total_tokens: int | None = None
    total_cost_usd: float | None = None

    for worker in results:
        for attempt in worker.get("attempts", []):
            usage = attempt.get("usage")
            tok = extract_tokens(usage)
            if tok is not None:
                total_tokens = (total_tokens or 0) + tok
            cst = extract_cost(usage)
            if cst is not None:
                total_cost_usd = (total_cost_usd or 0.0) + cst

    if total_cost_usd is not None:
        total_cost_usd = round(total_cost_usd, 6)

    packet = {
        "schema_version": 3,
        "harness": args.harness,
        "model": args.model,
        "agent": args.agent if args.harness == "opencode" else None,
        "prompt_path": str(prompt_path),
        "prompt_sha256": prompt_sha256,
        "requested_workers": args.workers,
        "concurrency": args.concurrency,
        "timeout_seconds": args.timeout_seconds,
        "agy_retries": args.agy_retries if args.harness == "agy" else 0,
        "total_retries": sum(result["attempt_count"] - 1 for result in results),
        "min_results": args.min_results,
        "valid_results": valid_results,
        "total_tokens": total_tokens,
        "total_cost_usd": total_cost_usd,
        "elapsed_seconds": round(time.monotonic() - started, 3),
        "workers": results,
    }
    packet_path = output / "packet.json"
    temp_packet_path = output / f"packet.json.tmp.{os.getpid()}"
    temp_packet_path.write_text(
        json.dumps(packet, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    temp_packet_path.chmod(0o600)
    os.replace(temp_packet_path, packet_path)

    summary: dict[str, Any] = {
        "status": "ok" if valid_results >= args.min_results else "insufficient_results",
        "valid_results": valid_results,
        "requested_workers": args.workers,
        "packet_path": str(packet_path),
    }
    if total_tokens is not None:
        summary["total_tokens"] = total_tokens
    if total_cost_usd is not None:
        summary["total_cost_usd"] = total_cost_usd
    print(json.dumps(summary, sort_keys=True))
    return 0 if valid_results >= args.min_results else 1


def main() -> int:
    try:
        return asyncio.run(run(parse_args()))
    except (OSError, UnicodeError, ValueError) as error:
        print(f"fanout: {error}", file=sys.stderr)
        return 2
    except (asyncio.CancelledError, KeyboardInterrupt):
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
